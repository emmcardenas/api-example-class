# GitHub OAuth Configuration
# Create a GitHub OAuth App at: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# OAuth Callback URL - Update this after deployment with your actual API Gateway URL
# Format: https://your-api-gateway-id.execute-api.region.amazonaws.com/stage/auth/github/callback
GITHUB_REDIRECT_URI=https://your-api-gateway-url.amazonaws.com/dev/auth/github/callback

# JWT Secret Key - Use a strong, random secret key
# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_here

# Instructions:
# 1. Copy this file to .env
# 2. Fill in your actual values
# 3. Never commit .env to version control
# 4. Source the file before deployment: source .env